<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/brand_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="欢迎来到减肥对赌"
            android:textColor="@color/brand_text"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="和朋友一起挑战减肥目标"
            android:textColor="@color/brand_text_secondary"
            android:textSize="16sp" />
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/brand_primary_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="计划概览"
                    android:textColor="@color/brand_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvCheckInStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="今日打卡：--"
                    android:textColor="@color/brand_text"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/tvBalance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="钱包余额：¥--"
                    android:textColor="@color/brand_text"
                    android:textSize="15sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreatePlan"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical|start"
            android:text="创建计划&#10;发起新的减肥挑战"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:backgroundTint="@color/brand_primary"
            android:elevation="2dp"
            app:cornerRadius="20dp"
            app:icon="@android:drawable/ic_input_add"
            app:iconGravity="textStart"
            app:iconPadding="16dp"
            app:iconTint="@color/white" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMyPlans"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical|start"
            android:text="我的计划&#10;查看所有对赌计划"
            android:textColor="@color/brand_primary_dark"
            android:textSize="16sp"
            android:backgroundTint="@color/white"
            android:elevation="2dp"
            app:cornerRadius="20dp"
            app:icon="@android:drawable/ic_menu_sort_by_size"
            app:iconGravity="textStart"
            app:iconPadding="16dp"
            app:iconTint="@color/brand_primary"
            app:strokeColor="@color/brand_primary"
            app:strokeWidth="1dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckIn"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:gravity="center_vertical|start"
            android:text="每日打卡&#10;记录今天的体重"
            android:textColor="@color/brand_accent"
            android:textSize="16sp"
            android:backgroundTint="@color/brand_accent_surface"
            android:elevation="2dp"
            app:cornerRadius="20dp"
            app:icon="@android:drawable/ic_menu_edit"
            app:iconGravity="textStart"
            app:iconPadding="16dp"
            app:iconTint="@color/brand_accent"
            app:strokeColor="@color/brand_accent"
            app:strokeWidth="1dp" />
    </LinearLayout>
</ScrollView>
