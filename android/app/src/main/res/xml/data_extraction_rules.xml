<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never restore authentication or pending payment state to another device. -->
        <exclude domain="file" path="datastore/auth_prefs.preferences_pb" />
        <exclude domain="sharedpref" path="encrypted_auth_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth_prefs.preferences_pb" />
        <exclude domain="sharedpref" path="encrypted_auth_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
