# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/weight_loss_betting
DATABASE_ECHO=False

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# JWT 配置
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe 配置
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYMENT_PROVIDER=demo
STRIPE_CURRENCY=cny
STRIPE_CONNECT_COUNTRY=US
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/payment/connect/complete
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/payment/connect/retry

# Firebase 配置 (用于推送通知)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Google Identity Services。填入 Web、Android、iOS 对应的 OAuth Client ID，逗号分隔
# 未配置时 /api/auth/google 会拒绝登录，不会接受未校验 audience 的 Token
GOOGLE_CLIENT_IDS=web-client-id.apps.googleusercontent.com,android-client-id.apps.googleusercontent.com

# 应用配置
APP_NAME=Weight Loss Betting API
APP_VERSION=1.0.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
